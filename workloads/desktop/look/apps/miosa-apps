#!/usr/bin/env python3
"""MIOSA Apps: what is on this machine, and one click to add more. The same from a terminal or an agent.

  miosa-apps                  open the Apps window
  miosa-apps list             every app, and whether it is on this machine
  miosa-apps install <id>     install one
  miosa-apps remove <id>      remove one

The catalog is /usr/share/miosa-apps/catalog.json. Installing and removing go through the root-owned
installer /usr/local/libexec/miosa-apps/install, the one command the desktop user may run as root;
it also answers what is installed (--status), by looking for each app on the machine itself.
"""

import json
import os
import shlex
import subprocess
import sys

CATALOG = "/usr/share/miosa-apps/catalog.json"
INSTALLER = "/usr/local/libexec/miosa-apps/install"
LOGS = os.path.expanduser("~/.cache/miosa-apps")


def catalog():
    with open(CATALOG) as f:
        return json.load(f)


def installed_ids():
    out = subprocess.run(["sudo", "-n", INSTALLER, "--status"], capture_output=True, text=True)
    return set(out.stdout.split())


def cli(args):
    if args[0] == "list":
        on = installed_ids()
        for app in catalog():
            state = "built in" if app.get("builtin") else ("installed" if app["id"] in on else "-")
            print(f"{app['id']:<13} {state:<10} {app['name']}: {app['about']}")
        return 0
    if args[0] in ("install", "remove") and len(args) == 2:
        flag = [] if args[0] == "install" else ["--remove"]
        return subprocess.run(["sudo", "-n", INSTALLER, *flag, args[1]]).returncode
    print(__doc__.strip(), file=sys.stderr)
    return 2


if len(sys.argv) > 1:
    sys.exit(cli(sys.argv[1:]))

