#!/usr/bin/env python3
"""MIOSA Apps: install tools into this machine with one click, or from a terminal or an agent.

  miosa-apps                 open the Apps window
  miosa-apps list            every app in the catalog and whether it is installed
  miosa-apps install <id>    install one (the same root installer the window uses)

The catalog is /usr/share/miosa-apps/catalog.json; the recipes live in the root-owned installer
/usr/local/libexec/miosa-apps/install, the only command the desktop user may run as root.
"""

import json
import os
import subprocess
import sys

CATALOG = "/usr/share/miosa-apps/catalog.json"
INSTALLER = "/usr/local/libexec/miosa-apps/install"
LOGS = os.path.expanduser("~/.cache/miosa-apps")


def catalog():
    with open(CATALOG) as f:
        return json.load(f)


def installed(app_id):
    return subprocess.run(["sudo", "-n", INSTALLER, "--check", app_id],
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def cli(args):
    if args[0] == "list":
        for app in catalog():
            mark = "installed" if installed(app["id"]) else "-"
            print(f"{app['id']:<14} {mark:<10} {app['name']}: {app['about']}")
        return 0
    if args[0] == "install" and len(args) == 2:
        return subprocess.run(["sudo", "-n", INSTALLER, args[1]]).returncode
    print(__doc__.strip(), file=sys.stderr)
    return 2


if len(sys.argv) > 1:
    sys.exit(cli(sys.argv[1:]))

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GLib, Gtk  # noqa: E402

CSS = b"""
window, .main { background: #0c0e16; color: #e8ebf5; }
headerbar { background: #121522; border: none; box-shadow: none; padding: 6px 12px; }
.section { font: 600 10pt Inter; color: #8d95ad; letter-spacing: 1px; margin: 18px 22px 8px 22px; }
.card { background: rgba(255,255,255,0.045); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; padding: 14px; }
.name { font: 600 11pt Inter; color: #f2f4fb; }
.about { font: 9.5pt Inter; color: #9aa3ba; }
.install { background: #3b5bdb; color: #ffffff; border: none; border-radius: 8px; padding: 4px 14px; font: 600 9.5pt Inter; box-shadow: none; }
.install:hover { background: #4c6ef5; }
.done { background: rgba(255,255,255,0.08); color: #b9c1d6; border: none; border-radius: 8px; padding: 4px 14px; font: 500 9.5pt Inter; box-shadow: none; }
.busy { color: #8fa8ff; font: 500 9.5pt Inter; }
.failed { color: #ff8a80; font: 500 9.5pt Inter; }
flowbox, flowboxchild { background: transparent; }
"""


class Card(Gtk.Box):
    def __init__(self, app):
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        self.app = app
        self.get_style_context().add_class("card")
        self.set_size_request(360, 0)
        theme = Gtk.IconTheme.get_default()
        icon_name = app["icon"] if theme.has_icon(app["icon"]) else "application-x-executable"
        self.pack_start(Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.DIALOG), False, False, 0)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        name = Gtk.Label(label=app["name"], xalign=0)
        name.get_style_context().add_class("name")
        about = Gtk.Label(label=app["about"], xalign=0, wrap=True, max_width_chars=34)
        about.get_style_context().add_class("about")
        text.pack_start(name, False, False, 0)
        text.pack_start(about, False, False, 0)
        self.pack_start(text, True, True, 0)
        self.action = Gtk.Box()
        self.pack_end(self.action, False, False, 0)
        self.show_state("installed" if installed(app["id"]) else "available")

    def show_state(self, state):
        for child in self.action.get_children():
            self.action.remove(child)
        if state == "available":
            widget = Gtk.Button(label="Install")
            widget.get_style_context().add_class("install")
            widget.connect("clicked", lambda *_: self.install())
        elif state == "installed":
            widget = Gtk.Button(label="Installed")
            widget.get_style_context().add_class("done")
            widget.set_sensitive(False)
        elif state == "busy":
            widget = Gtk.Label(label="Installing…")
            widget.get_style_context().add_class("busy")
        else:
            widget = Gtk.Button(label="Retry")
            widget.get_style_context().add_class("install")
            widget.set_tooltip_text(f"It did not install; the log is {LOGS}/{self.app['id']}.log")
            widget.connect("clicked", lambda *_: self.install())
        widget.set_valign(Gtk.Align.CENTER)
        self.action.pack_start(widget, False, False, 0)
        self.action.show_all()

    def install(self):
        os.makedirs(LOGS, exist_ok=True)
        log = open(os.path.join(LOGS, f"{self.app['id']}.log"), "w")
        proc = subprocess.Popen(["sudo", "-n", INSTALLER, self.app["id"]], stdout=log, stderr=log)
        self.show_state("busy")

        def poll():
            code = proc.poll()
            if code is None:
                return True
            log.close()
            self.show_state("installed" if code == 0 and installed(self.app["id"]) else "failed")
            return False

        GLib.timeout_add(700, poll)


class Window(Gtk.Window):
    def __init__(self):
        super().__init__(title="Apps")
        self.set_default_size(1180, 760)
        self.set_icon_name("system-software-install")
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.set_titlebar(Gtk.HeaderBar(title="Apps", subtitle="Install into this machine",
                                        show_close_button=True))
        scroll = Gtk.ScrolledWindow()
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        body.get_style_context().add_class("main")
        groups = {}
        for app in catalog():
            groups.setdefault(app["group"], []).append(app)
        for group, apps in groups.items():
            head = Gtk.Label(label=group.upper(), xalign=0)
            head.get_style_context().add_class("section")
            body.pack_start(head, False, False, 0)
            flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True)
            flow.set_max_children_per_line(3)
            flow.set_row_spacing(12)
            flow.set_column_spacing(12)
            flow.set_margin_start(20)
            flow.set_margin_end(20)
            for app in apps:
                flow.add(Card(app))
            body.pack_start(flow, False, False, 0)
        scroll.add(body)
        self.add(scroll)


if __name__ == "__main__":
    win = Window()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()
