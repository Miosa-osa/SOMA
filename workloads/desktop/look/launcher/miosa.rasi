/* The MIOSA search: a centred glass panel, like Spotlight. Opened by the bar's Search and Alt+Space. */
* {
    font: "Inter 12";
    bg: #12151fe6;
    line: #ffffff1f;
    text: #e9ecf4;
    dim: #8d95ad;
    pick: #3b5bdb;
    background-color: transparent;
    text-color: @text;
}
window { width: 640px; location: north; y-offset: 160px; border: 1px; border-color: @line; border-radius: 16px; background-color: @bg; padding: 10px; }
mainbox { spacing: 8px; }
inputbar { padding: 12px 14px; border-radius: 10px; background-color: #ffffff0f; children: [ prompt, entry ]; spacing: 10px; }
prompt { text-color: @dim; }
entry { placeholder: "Search apps"; placeholder-color: @dim; }
listview { lines: 7; spacing: 2px; scrollbar: false; }
element { padding: 9px 12px; border-radius: 9px; spacing: 12px; }
element selected { background-color: @pick; }
element-icon { size: 26px; }
element-text { vertical-align: 0.5; }
