BLUE, VIOLET, GREEN, AMBER, TEAL, GREY = (
    (0.36, 0.49, 0.98), (0.62, 0.45, 0.98), (0.31, 0.80, 0.56),
    (0.98, 0.70, 0.30), (0.25, 0.75, 0.85), (0.55, 0.58, 0.68),
)
WHOLE_DISK = re.compile(r"^(?:(?:vd|sd|xvd)[a-z]+|nvme\d+n\d+)$")


def human(n):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if abs(n) < 1024 or unit == "TB":
            return f"{n:.0f} {unit}" if unit in ("B", "KB") else f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} TB"


def duration(seconds):
    days, rest = divmod(int(seconds), 86400)
    hours, rest = divmod(rest, 3600)
    minutes = rest // 60
    if days:
        return f"{days} d {hours} h"
    if hours:
        return f"{hours} h {minutes} min"
    return f"{minutes} min"


def styled(widget, *classes):
    for cls in classes:
        widget.get_style_context().add_class(cls)
    return widget


def label(text="", cls="sub", xalign=0.0):
    widget = styled(Gtk.Label(label=text, xalign=xalign), cls)
    widget.set_ellipsize(3)  # Pango.EllipsizeMode.END: a long value never widens its column
    return widget


def cpu_ticks():
    """(busy, total) for the whole machine, then one (busy, total) per core."""
    rows = []
    with open("/proc/stat") as f:
        for line in f:
            if not line.startswith("cpu"):
                break
            v = [int(x) for x in line.split()[1:9]]
            idle = v[3] + v[4]
            rows.append((sum(v) - idle, sum(v)))
    return rows[0], rows[1:]


def meminfo():
    info = {}
    with open("/proc/meminfo") as f:
        for line in f:
            key, value = line.split(":", 1)
            info[key] = int(value.split()[0]) * 1024
    return info


def network():
    rx = tx = 0
    with open("/proc/net/dev") as f:
        for line in f.readlines()[2:]:
            name, data = line.split(":", 1)
            if name.strip() == "lo":
                continue
            fields = data.split()
            rx += int(fields[0])
            tx += int(fields[8])
    return rx, tx


def disk_io():
    """Bytes read and written by whole disks (not partitions) since boot."""
    read = written = 0
    try:
        with open("/proc/diskstats") as f:
            for line in f:
                fields = line.split()
                if not WHOLE_DISK.match(fields[2]):
                    continue
                read += int(fields[5]) * 512
                written += int(fields[9]) * 512
    except OSError:
        pass
    return read, written


def address():
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
            s.connect(("192.0.2.1", 9))
            return s.getsockname()[0]
    except OSError:
        return "no network"


def os_name():
    try:
        with open("/etc/os-release") as f:
            for line in f:
                if line.startswith("PRETTY_NAME="):
                    return line.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return platform.system()


def uptime():
    with open("/proc/uptime") as f:
        return float(f.read().split()[0])


def processes():
    out = []
    page = os.sysconf("SC_PAGE_SIZE")
    me = os.getuid()
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/stat") as f:
                stat = f.read()
            name = stat[stat.index("(") + 1: stat.rindex(")")]
            fields = stat[stat.rindex(")") + 2:].split()
            ticks = int(fields[11]) + int(fields[12])
            rss = int(fields[21]) * page
            mine = os.stat(f"/proc/{pid}").st_uid == me
            out.append((int(pid), name, ticks, rss, mine))
        except (OSError, ValueError, IndexError):
            continue
    return out


class Chart(Gtk.DrawingArea):
    """A filled line chart of one or more series over the last two minutes, scaled to its largest
    value (or to 100 for percentages), with the scale written in the top left corner."""

    def __init__(self, series, colors, percent=False, height=120, unit=None):
        super().__init__()
        self.series, self.colors, self.percent, self.unit = series, colors, percent, unit
        self.set_size_request(-1, height)
        self.connect("draw", self.draw)

    def draw(self, _w, cr):
        w, h = self.get_allocated_width(), self.get_allocated_height()
        cr.set_source_rgba(1, 1, 1, 0.06)
        cr.set_line_width(1)
        for i in range(1, 4):
            cr.move_to(0, h * i / 4 + 0.5)
            cr.line_to(w, h * i / 4 + 0.5)
        cr.stroke()
        top = 100.0 if self.percent else max([1.0] + [v for s in self.series for v in s])
        cr.set_source_rgba(1, 1, 1, 0.35)
        cr.select_font_face("Inter")
        cr.set_font_size(9)
        cr.move_to(2, 11)
        cr.show_text("100%" if self.percent else f"{human(top)}{self.unit or ''}")
        step = w / (HISTORY - 1)
        for data, (r, g, b) in zip(self.series, self.colors):
            if len(data) < 2:
                continue
            x0 = w - step * (len(data) - 1)
            points = [(x0 + i * step, h - 2 - (h - 16) * min(v / top, 1.0)) for i, v in enumerate(data)]
            cr.move_to(points[0][0], h)
            for x, y in points:
                cr.line_to(x, y)
            cr.line_to(points[-1][0], h)
            cr.close_path()
            cr.set_source_rgba(r, g, b, 0.16)
            cr.fill()
            cr.move_to(*points[0])
            for x, y in points[1:]:
                cr.line_to(x, y)
            cr.set_source_rgba(r, g, b, 0.95)
            cr.set_line_width(2)
            cr.stroke()
        return False


class Bar(Gtk.DrawingArea):
    """A rounded bar of one or more stacked parts, each (fraction, color)."""

    def __init__(self, height=10):
        super().__init__()
        self.parts = []
        self.set_size_request(-1, height)
        self.connect("draw", self.draw)

    @staticmethod
    def pill(cr, x, w, h):
        r = min(h / 2, w / 2)
        cr.new_sub_path()
        cr.arc(x + r, r, r, 1.5708, 4.7124)
        cr.arc(x + w - r, r, r, 4.7124, 1.5708)
        cr.close_path()

    def draw(self, _w, cr):
        w, h = self.get_allocated_width(), self.get_allocated_height()
        self.pill(cr, 0, w, h)
        cr.set_source_rgba(1, 1, 1, 0.08)
        cr.fill()
        x = 0.0
        for fraction, (r, g, b) in self.parts:
            width = w * max(0.0, min(fraction, 1.0))
            if width < 1:
                continue
            self.pill(cr, x, max(width, h if x == 0 else width), h)
            cr.set_source_rgba(r, g, b, 0.95)
            cr.fill()
            x += width
        return False


class Cores(Gtk.DrawingArea):
    """One thin vertical bar per processor, filled to how busy it was over the last second."""

    def __init__(self):
        super().__init__()
        self.values = []
        self.set_size_request(-1, 44)
        self.connect("draw", self.draw)

    def draw(self, _w, cr):
        w, h = self.get_allocated_width(), self.get_allocated_height()
        n = max(len(self.values), 1)
        gap = 4 if n <= 32 else 2
        bw = max((w - gap * (n - 1)) / n, 2)
        for i, v in enumerate(self.values):
            x = i * (bw + gap)
            cr.set_source_rgba(1, 1, 1, 0.07)
            cr.rectangle(x, 0, bw, h)
            cr.fill()
            fill = h * min(v / 100.0, 1.0)
            cr.set_source_rgba(*BLUE, 0.95 if v > 70 else 0.75)
            cr.rectangle(x, h - fill, bw, fill)
            cr.fill()
        return False


def tile(title):
    box = styled(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8), "tile")
    box.pack_start(label(title.upper(), "kicker"), False, False, 0)
    return box


def legend(*items):
    row = Gtk.Box(spacing=14)
    for text, color in items:
        dot = Gtk.DrawingArea()
        dot.set_size_request(8, 8)
        dot.set_valign(Gtk.Align.CENTER)
        dot.connect("draw", lambda _w, cr, c=color: (cr.arc(4, 4, 4, 0, 6.2832), cr.set_source_rgb(*c), cr.fill()))
        pair = Gtk.Box(spacing=6)
        pair.pack_start(dot, False, False, 0)
        pair.pack_start(label(text, "legend"), False, False, 0)
        row.pack_start(pair, False, False, 0)
    return row


class Window(Gtk.Window):
    def __init__(self):
        super().__init__(title="System")
        self.set_default_size(1180, 860)
        self.set_icon_name("utilities-system-monitor")
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.set_titlebar(Gtk.HeaderBar(title="System", subtitle="This machine, live", show_close_button=True))

        self.cpu_hist = deque(maxlen=HISTORY)
        self.mem_hist = deque(maxlen=HISTORY)
        self.rx_hist, self.tx_hist = deque(maxlen=HISTORY), deque(maxlen=HISTORY)
        self.rd_hist, self.wr_hist = deque(maxlen=HISTORY), deque(maxlen=HISTORY)
        self.last_cpu = cpu_ticks()
        self.last_net, self.last_io, self.last_t = network(), disk_io(), time.monotonic()
        self.last_proc = {p[0]: p[2] for p in processes()}
        self.sort_by = "cpu"
        self.drawn = []

        outer = styled(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin=18), "main")
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.add(outer)
        self.add(scroll)

        outer.pack_start(self.about_strip(), False, False, 0)
        grid = Gtk.Grid(column_spacing=14, row_spacing=14)
        grid.set_column_homogeneous(True)
        outer.pack_start(grid, False, False, 0)

        grid.attach(self.cpu_tile(), 0, 0, 2, 1)
        grid.attach(self.memory_tile(), 2, 0, 1, 1)
        grid.attach(self.network_tile(), 0, 1, 2, 1)
        grid.attach(self.disk_tile(), 2, 1, 1, 2)
        grid.attach(self.process_tile(), 0, 2, 2, 1)

        self.tick()
        self.scan_folders()
        GLib.timeout_add_seconds(1, self.tick)
        GLib.timeout_add_seconds(20, self.scan_folders)

    def about_strip(self):
        strip = styled(Gtk.Box(spacing=28), "about")
        self.about = {}
        for key in ("Name", "System", "Address", "Processors", "Memory", "Up"):
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            box.pack_start(label(key.upper(), "factkey"), False, False, 0)
            value = label("", "fact")
            box.pack_start(value, False, False, 0)
            strip.pack_start(box, False, False, 0)
            self.about[key] = value
        self.about["Name"].set_text(socket.gethostname())
        self.about["System"].set_text(f"{os_name()} · Linux {platform.release().split('-')[0]}")
        return strip

    def cpu_tile(self):
        box = tile("Processors")
        head = Gtk.Box(spacing=16)
        self.cpu_big = label("", "big")
        self.cpu_sub = label("", "sub")
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        col.pack_start(self.cpu_big, False, False, 0)
        col.pack_start(self.cpu_sub, False, False, 0)
        head.pack_start(col, False, False, 0)
        box.pack_start(head, False, False, 0)
        chart = Chart([self.cpu_hist], [BLUE], percent=True)
        self.cores = Cores()
        box.pack_start(chart, False, False, 4)
        box.pack_start(label("EACH PROCESSOR", "dim"), False, False, 2)
        box.pack_start(self.cores, False, False, 0)
        self.drawn += [chart, self.cores]
        return box

    def memory_tile(self):
        box = tile("Memory")
        self.mem_big = label("", "big")
        self.mem_sub = label("", "sub")
        self.mem_bar = Bar(12)
        chart = Chart([self.mem_hist], [VIOLET], percent=True, height=70)
        self.swap = label("", "sub")
        for w in (self.mem_big, self.mem_sub, self.mem_bar):
            box.pack_start(w, False, False, 0)
        box.pack_start(legend(("Apps", VIOLET), ("Cache", TEAL), ("Free", GREY)), False, False, 2)
        box.pack_start(chart, False, False, 4)
        box.pack_start(self.swap, False, False, 0)
        self.drawn += [self.mem_bar, chart]
        return box

    def network_tile(self):
        box = tile("Network")
        self.net_big = label("", "big")
        self.net_sub = label("", "sub")
        box.pack_start(self.net_big, False, False, 0)
        box.pack_start(self.net_sub, False, False, 0)
        box.pack_start(legend(("Download", GREEN), ("Upload", AMBER)), False, False, 2)
        chart = Chart([self.rx_hist, self.tx_hist], [GREEN, AMBER], unit="/s")
        box.pack_start(chart, False, False, 4)
        self.drawn.append(chart)
        return box

    def disk_tile(self):
        box = tile("Disk")
        self.disk_big = label("", "big")
        self.disk_sub = label("", "sub")
        self.disk_bar = Bar(12)
        for w in (self.disk_big, self.disk_sub, self.disk_bar):
            box.pack_start(w, False, False, 0)
        note = label("System files live in the machine image and are not counted here.", "legend")
        note.set_ellipsize(0)  # wrap this one instead
        note.set_line_wrap(True)
        note.set_max_width_chars(34)
        box.pack_start(note, False, False, 0)
        self.io_big = label("", "mid")
        box.pack_start(self.io_big, False, False, 6)
        box.pack_start(legend(("Read", TEAL), ("Write", AMBER)), False, False, 0)
        chart = Chart([self.rd_hist, self.wr_hist], [TEAL, AMBER], unit="/s", height=90)
        box.pack_start(chart, False, False, 4)
        box.pack_start(label("LARGEST IN YOUR HOME FOLDER", "kicker"), False, False, 8)
        self.folders = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        box.pack_start(self.folders, False, False, 0)
        self.drawn += [self.disk_bar, chart]
        return box

    def process_tile(self):
        box = tile("Processes")
        bar = Gtk.Box(spacing=6)
        self.count = label("", "sub")
        bar.pack_start(self.count, False, False, 0)
        self.sort_buttons = {}
        for key, text in (("mem", "Memory"), ("cpu", "CPU")):
            button = styled(Gtk.Button(label=text), "seg")
            button.connect("clicked", self.sort_on, key)
            bar.pack_end(button, False, False, 0)
            self.sort_buttons[key] = button
        box.pack_start(bar, False, False, 0)
        self.proc_grid = Gtk.Grid(column_spacing=18, row_spacing=4)
        box.pack_start(self.proc_grid, False, False, 4)
        self.status = label("", "legend")
        box.pack_start(self.status, False, False, 0)
        self.mark_sort()
        return box

    def sort_on(self, _button, key):
        self.sort_by = key
        self.mark_sort()
        self.render_processes()

    def mark_sort(self):
        for key, button in self.sort_buttons.items():
            ctx = button.get_style_context()
            (ctx.add_class if key == self.sort_by else ctx.remove_class)("on")

    def end_process(self, _button, pid, name):
        try:
            os.kill(pid, signal.SIGTERM)
            self.status.set_text(f"Asked {name} ({pid}) to end.")
        except PermissionError:
            self.status.set_text(f"{name} ({pid}) belongs to the system; it cannot be ended from here.")
        except ProcessLookupError:
            self.status.set_text(f"{name} ({pid}) had already ended.")

    def tick(self):
        now = time.monotonic()
        dt = max(now - self.last_t, 0.001)

        (busy, total), cores = cpu_ticks()
        (lb, lt), last_cores = self.last_cpu
        pct = 100.0 * (busy - lb) / (total - lt) if total > lt else 0.0
        self.cores.values = [100.0 * (b - pb) / (t - pt) if t > pt else 0.0
                             for (b, t), (pb, pt) in zip(cores, last_cores)]
        self.last_cpu = ((busy, total), cores)
        self.cpu_hist.append(pct)
        load = os.getloadavg()
        self.cpu_big.set_text(f"{pct:.0f}%")
        self.cpu_sub.set_text(f"of {len(cores)} processors · load {load[0]:.2f}  {load[1]:.2f}  {load[2]:.2f}")

        m = meminfo()
        mtotal = m["MemTotal"]
        free = m.get("MemFree", 0)
        cache = m.get("Buffers", 0) + m.get("Cached", 0) + m.get("SReclaimable", 0)
        used = mtotal - m["MemAvailable"]
        apps = max(mtotal - free - cache, 0)
        self.mem_hist.append(100.0 * used / mtotal)
        self.mem_big.set_text(human(used))
        self.mem_sub.set_text(f"in use of {human(mtotal)} · {human(m['MemAvailable'])} available")
        self.mem_bar.parts = [(apps / mtotal, VIOLET), (cache / mtotal, TEAL)]
        swap_total = m.get("SwapTotal", 0)
        self.swap.set_text(f"Swap: {human(swap_total - m.get('SwapFree', 0))} of {human(swap_total)}"
                           if swap_total else "No swap: memory grows with the machine instead")

        rx, tx = network()
        rx_rate, tx_rate = (rx - self.last_net[0]) / dt, (tx - self.last_net[1]) / dt
        self.last_net = (rx, tx)
        self.rx_hist.append(rx_rate)
        self.tx_hist.append(tx_rate)
        self.net_big.set_text(f"↓ {human(rx_rate)}/s   ↑ {human(tx_rate)}/s")
        self.net_sub.set_text(f"Since start: {human(rx)} downloaded, {human(tx)} uploaded")

        st = os.statvfs("/")
        dtotal, dfree = st.f_blocks * st.f_frsize, st.f_bavail * st.f_frsize
        dused = dtotal - dfree
        self.disk_big.set_text(f"{human(dfree)} free")
        self.disk_sub.set_text(f"{human(dused)} used of {human(dtotal)} for your files and apps")
        self.disk_bar.parts = [(dused / dtotal if dtotal else 0, AMBER)]
        rd, wr = disk_io()
        rd_rate, wr_rate = (rd - self.last_io[0]) / dt, (wr - self.last_io[1]) / dt
        self.last_io = (rd, wr)
        self.rd_hist.append(rd_rate)
        self.wr_hist.append(wr_rate)
        self.io_big.set_text(f"Read {human(rd_rate)}/s · Write {human(wr_rate)}/s")

        self.about["Address"].set_text(address())
        self.about["Processors"].set_text(f"{len(cores)}")
        self.about["Memory"].set_text(human(mtotal))
        self.about["Up"].set_text(duration(uptime()))

        procs = processes()
        hz = os.sysconf("SC_CLK_TCK")
        self.rows = []
        for pid, name, ticks, rss, mine in procs:
            cpu = 100.0 * (ticks - self.last_proc.get(pid, ticks)) / hz / dt
            self.rows.append((cpu, rss, pid, name, mine))
        self.last_proc = {p[0]: p[2] for p in procs}
        self.count.set_text(f"{len(procs)} running")
        self.render_processes()

        for widget in self.drawn:
            widget.queue_draw()
        self.last_t = now
        return True

    def render_processes(self):
        key = (lambda r: (r[0], r[1])) if self.sort_by == "cpu" else (lambda r: (r[1], r[0]))
        rows = sorted(getattr(self, "rows", []), key=key, reverse=True)[:PROCESS_ROWS]
        for child in self.proc_grid.get_children():
            self.proc_grid.remove(child)
        for col, (text, align) in enumerate((("PROCESS", 0), ("CPU", 1), ("MEMORY", 1), ("PID", 1), ("", 1))):
            self.proc_grid.attach(label(text, "dim", align), col, 0, 1, 1)
        for i, (cpu, rss, pid, name, mine) in enumerate(rows, start=1):
            name_label = label(name[:32], "row")
            name_label.set_hexpand(True)
            self.proc_grid.attach(name_label, 0, i, 1, 1)
            self.proc_grid.attach(label(f"{cpu:.1f}%", "row", 1), 1, i, 1, 1)
            self.proc_grid.attach(label(human(rss), "row", 1), 2, i, 1, 1)
            self.proc_grid.attach(label(str(pid), "row", 1), 3, i, 1, 1)
            if mine:
                end = styled(Gtk.Button(label="End"), "end")
                end.connect("clicked", self.end_process, pid, name)
                self.proc_grid.attach(end, 4, i, 1, 1)
        self.proc_grid.show_all()

    def scan_folders(self):
        home = os.path.expanduser("~")
        sizes = []
        for entry in os.scandir(home):
            if entry.is_symlink():
                continue
            total = 0
            if entry.is_dir():
                for root, _dirs, files in os.walk(entry.path):
                    for name in files:
                        try:
                            total += os.lstat(os.path.join(root, name)).st_size
                        except OSError:
                            pass
            else:
                try:
                    total = entry.stat().st_size
                except OSError:
                    continue
            sizes.append((total, entry.name))
        sizes.sort(reverse=True)
        for child in self.folders.get_children():
            self.folders.remove(child)
        biggest = max([s for s, _ in sizes[:1]] + [1])
        for total, name in sizes[:7]:
            row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            row.pack_start(label(f"{human(total):>10}  {name}", "row"), False, False, 0)
            bar = Bar(3)
            bar.parts = [(total / biggest, (0.98, 0.70, 0.30))]
            bar.set_opacity(0.55)
            row.pack_start(bar, False, False, 0)
            self.folders.pack_start(row, False, False, 0)
        self.folders.show_all()
        return True


