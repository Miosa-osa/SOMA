#!/usr/bin/env python3
"""MIOSA System: what this machine is and what it is using, live.

About strip (name, system, address, up time), processors (total chart, one bar per core, load),
memory (chart, apps / cache / free split, swap), network (down and up chart, totals), disk (space
for your files, read and write chart, largest folders), and processes (sort by CPU or memory, end
one). Read from /proc and statvfs once a second; nothing runs while the window is closed."""

import os
import platform
import re
import signal
import socket
import time
from collections import deque

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GLib, Gtk  # noqa: E402

HISTORY = 120
PROCESS_ROWS = 14
GLib.set_prgname("miosa-system")
GLib.set_application_name("System")

