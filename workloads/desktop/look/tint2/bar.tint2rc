# The top bar: the MIOSA mark and the open windows on the left, the clock on the right.
rounded = 0
border_width = 0
background_color = #172233 100
border_color = #0e1016 0
background_color_hover = #0e1016 100
border_color_hover = #0e1016 100
background_color_pressed = #0e1016 100
border_color_pressed = #0e1016 100

# 2: a window in the task list
rounded = 6
border_width = 0
background_color = #0e1016 0
border_color = #0e1016 0
background_color_hover = #29394d 100
border_color_hover = #29394d 100
background_color_pressed = #344961 100
border_color_pressed = #344961 100

# 3: the active window
rounded = 6
border_width = 0
background_color = #29394d 100
border_color = #29394d 100
background_color_hover = #344961 100
border_color_hover = #344961 100
background_color_pressed = #344961 100
border_color_pressed = #344961 100

panel_items = ETC
panel_size = 100% 40
panel_margin = 0 0
panel_padding = 16 5 12
panel_background_id = 1
wm_menu = 0
panel_dock = 0
panel_position = top center horizontal
panel_layer = top
panel_monitor = all
strut_policy = follow_size
panel_window_name = miosa-bar
disable_transparency = 0
font_shadow = 0
mouse_effects = 1

execp = new
execp_command = printf '/usr/share/soma-desktop/miosa-icon.png\nMIOSA\n'
execp_interval = 0
execp_has_icon = 1
execp_icon_w = 18
execp_icon_h = 18
execp_font = Inter Bold 10
execp_font_color = #edf3fa 100
execp_padding = 8 2 8
execp_background_id = 2
execp_centered = 1

taskbar_mode = single_desktop
taskbar_padding = 12 0 4
taskbar_background_id = 0
taskbar_name = 0
taskbar_hide_inactive_tasks = 0
taskbar_distribute_size = 0
task_icon = 1
task_text = 1
task_centered = 0
task_maximum_size = 260 28
task_padding = 9 2 6
task_font = Inter 10
task_font_color = #bdcadb 100
task_active_font_color = #ffffff 100
task_background_id = 2
task_active_background_id = 3
task_urgent_background_id = 3
task_iconified_background_id = 2
mouse_left = toggle_iconify
mouse_middle = close

time1_format = %a, %b %d  %H:%M
time1_font = Inter Medium 10
clock_font_color = #d2deed 100
clock_padding = 10 0
clock_background_id = 0
