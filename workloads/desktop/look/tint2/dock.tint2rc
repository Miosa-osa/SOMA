# The dock: a floating rounded launcher centered at the bottom of the screen.
rounded = 13
border_width = 1
background_color = #182537 100
border_color = #4a6079 85
background_color_hover = #14161d 100
border_color_hover = #2a2f3a 100
background_color_pressed = #14161d 100
border_color_pressed = #2a2f3a 100

# 2: one launcher icon
rounded = 10
border_width = 0
background_color = #14161d 0
border_color = #14161d 0
background_color_hover = #33485e 100
border_color_hover = #33485e 100
background_color_pressed = #405974 100
border_color_pressed = #405974 100

panel_items = L
panel_size = 0 60
panel_shrink = 1
panel_margin = 0 16
panel_padding = 12 6 10
panel_background_id = 1
wm_menu = 0
panel_dock = 0
panel_position = bottom center horizontal
panel_layer = top
panel_monitor = all
strut_policy = none
panel_window_name = miosa-dock
disable_transparency = 0
mouse_effects = 1
mouse_hover_icon_asb = 100 0 12

launcher_padding = 3 0 10
launcher_background_id = 0
launcher_icon_background_id = 2
launcher_icon_size = 38
launcher_icon_theme = Yaru
launcher_icon_theme_override = 0
launcher_tooltip = 1
launcher_item_app = /usr/share/applications/google-chrome.desktop
launcher_item_app = /usr/share/applications/xfce4-terminal.desktop
launcher_item_app = /usr/share/applications/thunar.desktop
