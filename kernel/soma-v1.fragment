# SOMA x86_64 machine contract v1 kernel fragment.
# Applied on top of `make x86_64_defconfig` by `build.sh regen-config` to
# produce config-x86_64-soma-v1.  The full config is the pinned artifact; this
# fragment documents the intent behind every delta from the upstream defconfig.

# ---- Identity ---------------------------------------------------------------
CONFIG_LOCALVERSION="-soma-v1"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="soma"
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# ---- Platform: PVH direct boot at a fixed link address ----------------------
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_PARAVIRT_SPINLOCKS=y
CONFIG_KVM_GUEST=y
CONFIG_PVH=y
CONFIG_PHYSICAL_START=0x1000000
CONFIG_PHYSICAL_ALIGN=0x200000
# CONFIG_RELOCATABLE is not set
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_X86_5LEVEL is not set
# CONFIG_XEN is not set
# CONFIG_JAILHOUSE_GUEST is not set
# CONFIG_ACRN_GUEST is not set
# CONFIG_INTEL_TDX_GUEST is not set
# CONFIG_AMD_MEM_ENCRYPT is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_IA32_EMULATION is not set
# CONFIG_X86_X32_ABI is not set
# CONFIG_NUMA is not set
# CONFIG_MICROCODE stays y: def_bool y for CPU_SUP_INTEL or CPU_SUP_AMD.
# CONFIG_X86_16BIT is not set
# CONFIG_X86_IOPL_IOPERM is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_CRASH_DUMP is not set
# CONFIG_HOTPLUG_CPU stays y: def_bool y when SMP=y since Linux 6.x.
# CONFIG_MEMORY_HOTPLUG is not set
# CONFIG_X86_MCE is not set
# CONFIG_X86_CPUID is not set
# CONFIG_X86_MSR is not set
# CONFIG_ISA_DMA_API is not set
# CONFIG_X86_PLATFORM_DEVICES is not set
# CONFIG_X86_EXTENDED_PLATFORM is not set

# ---- No firmware, no ACPI, no PCI, no power management ----------------------
# CONFIG_EFI is not set
# CONFIG_ACPI is not set
# CONFIG_PCI is not set
# CONFIG_PCCARD is not set
# CONFIG_RAPIDIO is not set
# CONFIG_PNP is not set
# CONFIG_DMI is not set
# CONFIG_HPET_TIMER stays y: def_bool X86_64.
# CONFIG_HPET is not set
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
# CONFIG_PM is not set
# CONFIG_SCHED_MC_PRIO is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_CPU_IDLE is not set
# CONFIG_X86_INTEL_LPSS is not set
# CONFIG_X86_AMD_PLATFORM_DEVICE is not set
# CONFIG_IOMMU_SUPPORT is not set
# CONFIG_INTEL_IOMMU is not set
# CONFIG_AMD_IOMMU is not set

# ---- No modules -------------------------------------------------------------
# CONFIG_MODULES is not set

# ---- Virtio over MMIO only --------------------------------------------------
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
# CONFIG_VIRTIO_PCI is not set
# CONFIG_VIRTIO_BALLOON is not set
# CONFIG_VIRTIO_MEM is not set
# CONFIG_VIRTIO_INPUT is not set
# CONFIG_VIRTIO_CONSOLE is not set
# CONFIG_VIRTIO_FS is not set
# CONFIG_VIRTIO_IOMMU is not set
# CONFIG_VDPA is not set
# CONFIG_VHOST_MENU is not set
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
# CONFIG_HW_RANDOM_TIMERIOMEM is not set
# CONFIG_HW_RANDOM_INTEL is not set
# CONFIG_HW_RANDOM_AMD is not set
# CONFIG_HW_RANDOM_VIA is not set

# ---- Diagnostic serial console, no VT, no input -----------------------------
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
# CONFIG_SERIAL_8250_EXTENDED is not set
# CONFIG_SERIAL_8250_DW is not set
# CONFIG_SERIAL_8250_LPSS is not set
# CONFIG_SERIAL_8250_MID is not set
# CONFIG_SERIAL_8250_PERICOM is not set
# CONFIG_SERIAL_NONSTANDARD is not set
CONFIG_UNIX98_PTYS=y
# CONFIG_LEGACY_PTYS is not set
# CONFIG_VT is not set
# CONFIG_INPUT is not set
# CONFIG_SERIO is not set
# CONFIG_GAMEPORT is not set
# CONFIG_HID_SUPPORT is not set
# /dev/mem is required: the guest agent reads the SOMA launch page through it.
# Unrestricted DEVMEM also turns off EXCLUSIVE_SYSTEM_RAM and PAGE_TABLE_CHECK.
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set
# CONFIG_IO_STRICT_DEVMEM is not set
# CONFIG_DEVPORT is not set
# CONFIG_NVRAM is not set
# CONFIG_TCG_TPM is not set

# ---- Excluded device classes -----------------------------------------------
# CONFIG_USB_SUPPORT is not set
# CONFIG_SOUND is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_VGA_CONSOLE is not set
# CONFIG_BACKLIGHT_CLASS_DEVICE is not set
# CONFIG_LCD_CLASS_DEVICE is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_MD is not set
# CONFIG_BLK_DEV_DM is not set
# CONFIG_BLK_DEV_LOOP is not set
# CONFIG_BLK_DEV_RAM is not set
# CONFIG_BLK_DEV_NBD is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_ETHERNET is not set
# CONFIG_PHYLIB is not set
# CONFIG_NET_VENDOR_INTEL is not set
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_CFG80211 is not set
# CONFIG_BT is not set
# CONFIG_NFC is not set
# CONFIG_RFKILL is not set
# CONFIG_I2C is not set
# CONFIG_SPI is not set
# CONFIG_GPIOLIB is not set
# CONFIG_HWMON is not set
# CONFIG_THERMAL is not set
# CONFIG_WATCHDOG is not set
# CONFIG_MFD_CORE is not set
# CONFIG_REGULATOR is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_RTC_CLASS is not set
# CONFIG_DMADEVICES is not set
# CONFIG_STAGING is not set
# CONFIG_NEW_LEDS is not set
# CONFIG_MEMSTICK is not set
# CONFIG_MMC is not set
# CONFIG_INFINIBAND is not set
# CONFIG_EDAC is not set
# CONFIG_VIRT_DRIVERS is not set
# CONFIG_NVMEM is not set
# CONFIG_UIO is not set
# CONFIG_VFIO is not set
# CONFIG_MACINTOSH_DRIVERS is not set
# CONFIG_MISC_DEVICES is not set
# CONFIG_AGP is not set
# CONFIG_ACCESSIBILITY is not set
# CONFIG_AUXDISPLAY is not set
# CONFIG_PARPORT is not set
# CONFIG_CONNECTOR is not set
# CONFIG_FIREWIRE is not set
# CONFIG_ISDN is not set
# CONFIG_FUSION is not set
# CONFIG_TARGET_CORE is not set
# CONFIG_NTB is not set
# CONFIG_PWM is not set
# CONFIG_RESET_CONTROLLER is not set
# CONFIG_ANDROID_BINDER_IPC is not set
# CONFIG_DAX is not set
# CONFIG_LIBNVDIMM is not set
# CONFIG_INTEL_TH is not set
# CONFIG_FPGA is not set
# CONFIG_INTERCONNECT is not set
# CONFIG_COUNTER is not set
# CONFIG_MOST is not set
# CONFIG_PECI is not set
# CONFIG_HTE is not set
# CONFIG_EXTCON is not set
# CONFIG_MEMORY is not set
# CONFIG_IIO is not set

# ---- Networking: basic IPv4 and IPv6, no netfilter --------------------------
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
# CONFIG_NETFILTER is not set
# CONFIG_BRIDGE is not set
# CONFIG_VLAN_8021Q is not set
# CONFIG_NET_SCHED is not set
# CONFIG_IP_MULTICAST is not set
# CONFIG_IP_ADVANCED_ROUTER is not set
# CONFIG_IP_PNP is not set
# CONFIG_INET_DIAG is not set
# CONFIG_TCP_CONG_ADVANCED is not set
# CONFIG_NET_9P is not set
# CONFIG_NETLINK_DIAG is not set
# CONFIG_XFRM_USER is not set
# CONFIG_INET_AH is not set
# CONFIG_INET_ESP is not set
# CONFIG_INET6_AH is not set
# CONFIG_INET6_ESP is not set
# CONFIG_IPV6_SIT is not set
# CONFIG_IPV6_TUNNEL is not set
# CONFIG_NET_IPIP is not set
# CONFIG_IP_MROUTE is not set
# CONFIG_NETDEVSIM is not set
# CONFIG_BPF_JIT is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_NET_DEVLINK is not set
# CONFIG_FAILOVER is not set
# CONFIG_NET_FAILOVER is not set
# CONFIG_ETHTOOL_NETLINK is not set
# CONFIG_WIREGUARD is not set

# ---- Filesystems ------------------------------------------------------------
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
# CONFIG_EROFS_FS_ZIP is not set
# CONFIG_EROFS_FS_ONDEMAND is not set
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_OVERLAY_FS=y
# CONFIG_OVERLAY_FS_INDEX is not set
CONFIG_OVERLAY_FS_XINO_AUTO=y
CONFIG_OVERLAY_FS_METACOPY=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_FS_POSIX_ACL=y
CONFIG_INOTIFY_USER=y
# CONFIG_EXT2_FS is not set
# CONFIG_EXT3_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_REISERFS_FS is not set
# CONFIG_JFS_FS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_UDF_FS is not set
# CONFIG_MSDOS_FS is not set
# CONFIG_VFAT_FS is not set
# CONFIG_EXFAT_FS is not set
# CONFIG_NTFS3_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_FUSE_FS is not set
# CONFIG_AUTOFS_FS is not set
# CONFIG_NETWORK_FILESYSTEMS is not set
# CONFIG_HUGETLBFS is not set
# CONFIG_PSTORE is not set
# CONFIG_QUOTA is not set
# CONFIG_FANOTIFY is not set
# CONFIG_DNOTIFY is not set
CONFIG_MISC_FILESYSTEMS=y
# CONFIG_FS_ENCRYPTION is not set
# CONFIG_FS_VERITY is not set
# CONFIG_NLS is not set
# CONFIG_BINFMT_MISC is not set

# ---- Boot inputs --------------------------------------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
# CONFIG_CMDLINE_BOOL is not set
# CONFIG_SWAP is not set

# ---- Process isolation primitives used by the guest agent -------------------
CONFIG_MULTIUSER=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CPUSETS=y
# CONFIG_BLK_CGROUP is not set
# CONFIG_CGROUP_DEVICE is not set
# CONFIG_CGROUP_FREEZER is not set
# CONFIG_CGROUP_HUGETLB is not set
# CONFIG_CGROUP_PERF is not set
# CONFIG_CGROUP_BPF is not set
# CONFIG_CGROUP_MISC is not set
# CONFIG_CGROUP_RDMA is not set
# CONFIG_CGROUP_DEBUG is not set
# CONFIG_AUDIT is not set
# CONFIG_SECURITY_SELINUX is not set
# CONFIG_SECURITY_APPARMOR is not set
CONFIG_SECURITY=y
CONFIG_SECURITY_YAMA=y
CONFIG_LSM="yama"
# CONFIG_INTEGRITY is not set
# CONFIG_SYSTEM_TRUSTED_KEYRING is not set
# CONFIG_KEYS is not set
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_RANDSTRUCT_NONE=y

# ---- Crypto: the guest agent does its own Noise and hashing in userspace ----
# CONFIG_CRYPTO_USER is not set
# CONFIG_CRYPTO_USER_API is not set
# CONFIG_CRYPTO_USER_API_HASH is not set
# CONFIG_CRYPTO_USER_API_SKCIPHER is not set
# CONFIG_CRYPTO_USER_API_RNG is not set
# CONFIG_CRYPTO_USER_API_AEAD is not set
# CONFIG_CRYPTO_SELFTESTS is not set
# CONFIG_CRYPTO_MANAGER_DISABLE_TESTS is not set
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_CRC32C=y
CONFIG_CRYPTO_CRC32C_INTEL=y
# CONFIG_CRYPTO_AES_NI_INTEL is not set

# ---- No debug bloat, no tracing, no profiling -------------------------------
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_KERNEL stays y: selected by EXPERT and only gates the debug menu.
# CONFIG_DEBUG_MISC is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_UPROBES is not set
# CONFIG_PROFILING is not set
# CONFIG_PERF_EVENTS stays y: selected by X86 unconditionally.
# CONFIG_KGDB is not set
# CONFIG_DEBUG_BUGVERBOSE is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_DEBUG_MEMORY_INIT is not set
# CONFIG_RCU_TRACE is not set
# CONFIG_KUNIT is not set
# CONFIG_RUNTIME_TESTING_MENU is not set
# CONFIG_SAMPLES is not set
# CONFIG_LATENCYTOP is not set
# CONFIG_UNWINDER_FRAME_POINTER is not set
CONFIG_UNWINDER_ORC=y
CONFIG_KALLSYMS=y
# CONFIG_KALLSYMS_ALL is not set
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
# CONFIG_TRANSPARENT_HUGEPAGE is not set
# CONFIG_ZSWAP is not set
# CONFIG_ZSMALLOC is not set
# CONFIG_COMPAT_32BIT_TIME is not set
# CONFIG_KCMP is not set
# CONFIG_RSEQ is not set
CONFIG_EXPERT=y
# CONFIG_PCSPKR_PLATFORM is not set
# CONFIG_VGA_ARB is not set
