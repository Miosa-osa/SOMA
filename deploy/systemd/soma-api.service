[Unit]
Description=SOMA prepared sandbox API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/soma/api.env
WorkingDirectory=/opt/soma/runtime
ExecStart=/opt/soma/bin/soma-api --listen ${SOMA_LISTEN} --workers ${SOMA_WORKERS}
Restart=on-failure
RestartSec=1s
KillMode=mixed
TimeoutStopSec=30s
LimitNOFILE=1048576
TasksMax=infinity
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
