[Unit]
Description=SOMA prepared sandbox API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/soma/api.env
WorkingDirectory=/opt/soma/runtime
StateDirectory=soma
ExecStart=/opt/soma/bin/soma-api --state-root /var/lib/soma/state --listen 127.0.0.1:18787 --workers 64
Restart=on-failure
RestartSec=1s
KillMode=mixed
TimeoutStopSec=30s
LimitNOFILE=1048576
TasksMax=infinity
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
